# Copy to .env.local for local development only. Leave values blank until configured.
# Never commit .env.local or paste secret values into commands, logs, or documentation.

DATABASE_URL=

# Configure at least one AI provider. Gemini is required for semantic embeddings.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional Plaid sandbox sync.
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_SANDBOX_ACCESS_TOKEN=

# Telegram webhook and proactive alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# CockroachDB Cloud Managed MCP. The URL defaults to the official endpoint.
COCKROACH_MCP_API_KEY=
COCKROACH_MCP_CLUSTER_ID=
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp

# Optional local-only stdio transport. Setting this opts out of Cloud MCP.
COCKROACH_MCP_STDIO_COMMAND=
CRDB_ALLOW_WRITES=false
