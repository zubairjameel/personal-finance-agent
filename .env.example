# Copy this file to .env.local and fill in your own values.
# Windows: copy .env.example .env.local
# Mac/Linux: cp .env.example .env.local

# ── CockroachDB ────────────────────────────────────────────────────────────────
# Local insecure cluster (default for development):
DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable

# ── AI Brain — Fallback Cascade (set at least ONE) ────────────────────────────
# The agent tries providers in this order: Groq → Gemini → Anthropic
# If a key is missing, that provider is automatically skipped.

# 1. Groq — FREE, 14,400 requests/day, no credit card needed
#    Get key: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Google Gemini — FREE, 1,500 requests/day, no credit card needed
#    Get key: https://aistudio.google.com
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Anthropic Claude — PAID fallback (~$0.25 per 1M tokens)
#    Get key: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Plaid (Bank data sync) ────────────────────────────────────────────────────
# Sandbox = fake bank data, completely free. Get keys: https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SANDBOX_SECRET=your_plaid_sandbox_secret
PLAID_SANDBOX_ACCESS_TOKEN=access-sandbox-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── AWS (required for hackathon) ──────────────────────────────────────────────
# Free: S3 first 5GB free. Get keys: https://console.aws.amazon.com/iam
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-finance-agent-bucket

# ── Safety flags ──────────────────────────────────────────────────────────────
# Uncomment ONLY if you want the agent to write/delete data via MCP:
# CRDB_ALLOW_WRITES=true

# ── Telegram Bot (optional — for push alerts) ─────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id