# Copy this file to .env.local and fill in your own values.
# Windows: copy .env.example .env.local
# Mac/Linux: cp .env.example .env.local

# ── CockroachDB ────────────────────────────────────────────────────────────────
# Local insecure cluster (default for development):
DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable

# ── Anthropic (Claude AI) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Plaid (Bank data sync) ────────────────────────────────────────────────────
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SANDBOX_SECRET=your_plaid_sandbox_secret
PLAID_SANDBOX_ACCESS_TOKEN=access-sandbox-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── AWS Bedrock (optional — required for hackathon AWS requirement) ────────────
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1

# ── Safety flags ──────────────────────────────────────────────────────────────
# Uncomment ONLY if you want Claude to write/delete data via MCP (disabled by default for safety):
# CRDB_ALLOW_WRITES=true

# ── Telegram Bot (optional — for push alerts) ─────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id